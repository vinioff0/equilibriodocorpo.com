---
import Icon from './Icon.astro';
import { reviews, clinic, links } from '../data/site';

const ratingPct = (clinic.rating / 5) * 100;
const ratingLabel = clinic.rating.toLocaleString('pt-BR');
---

<section class="section reviews" id="avaliacoes" aria-labelledby="reviews-title">
  <div class="container reviews__grid">
    <div class="reviews__summary" data-reveal>
      <span class="eyebrow">Avaliações</span>
      <h2 id="reviews-title" class="title">Quem conhece, <span class="hl-2">recomenda.</span></h2>

      <div class="score">
        <div class="score__top">
          <Icon name="google" size={30} label="Google" />
          <span class="score__label">Avaliações no Google</span>
        </div>
        <p class="score__value"><strong>{ratingLabel}</strong><span>/5</span></p>
        <div class="score__stars" role="img" aria-label={`Nota ${ratingLabel} de 5 estrelas`}>
          <span class="score__stars-base">{Array.from({ length: 5 }).map(() => <Icon name="star" size={26} />)}</span>
          <span class="score__stars-fill" style={`width:${ratingPct}%`}>{Array.from({ length: 5 }).map(() => <Icon name="star" size={26} />)}</span>
        </div>
        <p class="score__count">Baseado em <strong>{clinic.reviewCount} avaliações</strong> no Google</p>
        <a class="btn btn--ghost btn--sm" href={links.reviews} target="_blank" rel="noopener">
          Ver todas as avaliações <Icon name="arrowUpRight" size={17} />
        </a>
      </div>
    </div>

    <ul class="reviews__list" role="list">
      {reviews.map((r, i) => (
        <li class:list={['review', { 'review--wide': i === 0 }]} data-reveal style={`--d:${i * 100}ms`}>
          <figure>
            <div class="review__top">
              <span class="stars" role="img" aria-label="5 de 5 estrelas">{Array.from({ length: 5 }).map(() => <Icon name="star" size={17} />)}</span>
              <svg class="review__quote" viewBox="0 0 32 24" width="34" height="26" aria-hidden="true"><path d="M0 24V14C0 6 4.5 1.2 12.5 0l1.3 3.4C9.3 4.8 7.2 7.5 7 11h6v13H0Zm18 0V14c0-8 4.5-12.8 12.5-14l1.3 3.4c-4.5 1.4-6.6 4.1-6.8 7.6h6v13H18Z" fill="currentColor"/></svg>
            </div>
            <blockquote><p>“{r.text}”</p></blockquote>
            <figcaption>
              <span class="review__avatar" aria-hidden="true"><Icon name="user" size={18} /></span>
              <span>
                <strong>{r.author ?? 'Paciente da clínica'}</strong>
                <small><Icon name="google" size={13} /> Avaliação no Google</small>
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .reviews {
    background:
      radial-gradient(700px 400px at 0% 0%, rgba(24, 180, 234, .1), transparent 60%),
      linear-gradient(180deg, #f5f1fd 0%, #f6f8fd 100%);
  }
  .reviews__grid { display: grid; grid-template-columns: .9fr 1.5fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .reviews__summary { position: sticky; top: calc(var(--header-h) + 2rem); }

  .score {
    margin-top: 2rem; padding: 2rem; border-radius: var(--r-lg); background: #fff; box-shadow: var(--shadow-md);
    display: grid; gap: .9rem; justify-items: start;
  }
  .score__top { display: flex; align-items: center; gap: .7rem; }
  .score__label { font-weight: 700; color: var(--ink); }
  .score__value { display: flex; align-items: baseline; gap: .2rem; line-height: 1; }
  .score__value strong { font-size: 4.2rem; font-weight: 800; color: var(--ink); letter-spacing: -.04em; }
  .score__value span { font-size: 1.4rem; font-weight: 700; color: var(--muted); }
  .score__stars { position: relative; display: inline-block; line-height: 0; }
  .score__stars-base, .score__stars-fill { display: inline-flex; gap: 3px; white-space: nowrap; }
  .score__stars :global(.icon) { flex: none; }
  .score__stars-base { color: #e5e8f0; }
  .score__stars-fill { position: absolute; inset: 0 auto 0 0; overflow: hidden; color: #f5b301; }
  .score__count { font-size: .95rem; }
  .score__count strong { color: var(--ink); }
  .score .btn { margin-top: .4rem; }

  .reviews__list { display: grid; grid-template-columns: 1fr 1fr; gap: 1.3rem; }
  .review--wide { grid-column: 1 / -1; }
  .review figure {
    margin: 0; height: 100%; display: flex; flex-direction: column; gap: 1.2rem;
    padding: 1.9rem; border-radius: var(--r-lg); background: #fff;
    box-shadow: 0 10px 30px -20px rgba(23, 60, 130, .35); border: 1px solid #edf0f7;
    transition: transform .4s var(--ease), box-shadow .4s var(--ease);
  }
  .review figure:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }
  .review--wide figure { background: linear-gradient(145deg, #ffffff 0%, #f4f0fd 100%); }
  .review__top { display: flex; justify-content: space-between; align-items: center; }
  .review__quote { color: var(--lilac); }
  .review blockquote { margin: 0; flex: 1; }
  .review blockquote p { color: var(--ink); font-size: 1.05rem; line-height: 1.65; font-weight: 500; }
  .review--wide blockquote p { font-size: clamp(1.08rem, 1rem + .4vw, 1.28rem); }
  .review figcaption { display: flex; align-items: center; gap: .75rem; padding-top: 1.1rem; border-top: 1px solid var(--line); }
  .review__avatar { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--grad-soft); color: var(--purple); }
  .review figcaption strong { display: block; color: var(--ink); font-size: .95rem; }
  .review figcaption small { display: inline-flex; align-items: center; gap: .3rem; color: var(--muted); font-size: .82rem; font-weight: 600; }

  @media (max-width: 960px) {
    .reviews__grid { grid-template-columns: 1fr; }
    .reviews__summary { position: static; }
  }
  @media (max-width: 640px) { .reviews__list { grid-template-columns: 1fr; } }
</style>
