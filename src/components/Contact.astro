---
import Icon from './Icon.astro';
import { clinic, links, whatsapp } from '../data/site';
---

<section class="section contact" id="contato" aria-labelledby="contact-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Contato e localização</span>
      <h2 id="contact-title" class="title">Estamos no <span class="hl">Centro de Palhoça.</span></h2>
      <p class="lead">Fale com a nossa equipe, tire suas dúvidas ou venha nos visitar.</p>
    </div>

    <div class="contact__grid">
      <div class="contact__info" data-reveal="left">
        <h3 class="contact__name">{clinic.name}</h3>

        <ul class="info-list">
          <li>
            <span class="info-list__icon"><Icon name="pin" size={22} /></span>
            <span>
              <small>Endereço</small>
              <address>{clinic.street} - {clinic.district}<br />{clinic.city} - {clinic.state}, {clinic.postalCode}</address>
            </span>
          </li>
          <li>
            <span class="info-list__icon"><Icon name="phone" size={22} /></span>
            <span>
              <small>Telefone e WhatsApp</small>
              <a href={links.tel} class="info-list__big">{clinic.phoneDisplay}</a>
            </span>
          </li>
          <li>
            <span class="info-list__icon info-list__icon--lilac"><Icon name="instagram" size={22} /></span>
            <span>
              <small>Instagram</small>
              <a href={clinic.instagramUrl} target="_blank" rel="noopener">{clinic.instagramHandle}</a>
            </span>
          </li>
        </ul>

        <div class="contact__actions">
          <a class="btn btn--whats" href={whatsapp()} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={20} /> Conversar pelo WhatsApp
          </a>
          <a class="btn btn--ghost" href={links.route} target="_blank" rel="noopener">
            <Icon name="route" size={19} /> Abrir rota
          </a>
          <a class="btn btn--ghost" href={clinic.instagramUrl} target="_blank" rel="noopener">
            <Icon name="instagram" size={19} /> Instagram
          </a>
        </div>
      </div>

      <div class="contact__map" data-reveal="right">
        <iframe
          title={`Mapa: localização da ${clinic.name}`}
          src={links.mapEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a class="contact__map-link" href={links.maps} target="_blank" rel="noopener">
          <Icon name="pin" size={16} /> Ver no Google Maps
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact { background: #fff; }
  .contact__grid {
    display: grid; grid-template-columns: 1fr 1.25fr; gap: 1.5rem;
    margin-top: clamp(2.2rem, 4vw, 3rem);
  }
  .contact__info {
    padding: clamp(1.8rem, 3.5vw, 2.6rem); border-radius: var(--r-lg);
    background: var(--grad-soft); border: 1px solid #e3e3f6;
  }
  .contact__name { font-size: 1.4rem; }
  .info-list { display: grid; gap: 1.4rem; margin-top: 1.8rem; }
  .info-list li { display: flex; gap: 1rem; align-items: flex-start; }
  .info-list__icon {
    flex: none; display: grid; place-items: center; width: 50px; height: 50px; border-radius: 15px;
    background: #fff; color: var(--blue); box-shadow: var(--shadow-sm);
  }
  .info-list__icon--lilac { color: var(--purple); }
  .info-list small { display: block; font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .info-list address { font-style: normal; color: var(--ink); font-weight: 700; font-size: 1.05rem; line-height: 1.5; margin-top: .15rem; }
  .info-list a { color: var(--ink); font-weight: 700; font-size: 1.05rem; transition: color .2s; }
  .info-list a:hover { color: var(--purple); }
  .info-list__big { font-size: 1.45rem !important; letter-spacing: -.01em; }

  .contact__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }

  .contact__map {
    position: relative; min-height: 460px; border-radius: var(--r-lg); overflow: hidden;
    background: var(--sky-soft); box-shadow: var(--shadow-md);
  }
  .contact__map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .contact__map-link {
    position: absolute; left: 1rem; bottom: 1rem; display: inline-flex; align-items: center; gap: .4rem;
    padding: .6rem 1rem; border-radius: 999px; background: #fff; box-shadow: var(--shadow-md);
    font-weight: 700; font-size: .9rem; color: var(--ink);
  }
  .contact__map-link:hover { color: var(--purple); }

  @media (max-width: 960px) {
    .contact__grid { grid-template-columns: minmax(0, 1fr); }
    .contact__map { min-height: 380px; }
  }
  @media (max-width: 480px) { .contact__actions .btn { width: 100%; } }
</style>
