---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { whatsapp } from '../data/site';
---

<Base title="Página não encontrada | Clínica Equilíbrio do Corpo" noindex>
  <main id="conteudo" class="nf">
    <a href="/" aria-label="Página inicial"><Logo /></a>
    <p class="nf__code">404</p>
    <h1>Página não encontrada</h1>
    <p>O endereço acessado não existe ou foi alterado.</p>
    <div class="nf__actions">
      <a class="btn btn--primary" href="/">Voltar ao início</a>
      <a class="btn btn--ghost" href={whatsapp()} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> Falar no WhatsApp</a>
    </div>
  </main>
</Base>

<style>
  .nf { min-height: 100vh; display: grid; place-content: center; justify-items: center; gap: 1rem; text-align: center; padding: 2rem; background: var(--grad-soft); }
  .nf__code { font-size: clamp(5rem, 15vw, 9rem); font-weight: 800; line-height: 1; margin-top: 2rem; background: var(--grad-brand); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .nf h1 { font-size: 2rem; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; margin-top: 1rem; }
</style>
